# NexusFlow Platform - Environment Variables

# Event Bus Service
EVENT_BUS_PORT=5001
MAX_EVENT_LOG=1000
FLASK_DEBUG=false

# API Gateway Service
GATEWAY_PORT=8080
EVENT_BUS_URL=http://localhost:5001
DASHBOARD_URL=http://localhost:3000

# Dashboard Service
DASHBOARD_PORT=3000

# General
LOG_LEVEL=INFO
